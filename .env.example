# Copy to .env for local development. Never commit .env.
NODE_ENV=development
PORT=3011
HOST=127.0.0.1
LOG_LEVEL=info

DATABASE_URL=postgres://unsaid:unsaid_local_dev@localhost:54332/unsaid

# Generate with: openssl rand -base64 48
SESSION_SECRET=dev_only_secret_replace_me_with_48_bytes_of_entropy
SESSION_TTL_HOURS=720

# MinIO locally; swap the endpoint and keys for Cloudflare R2 in production.
S3_ENDPOINT=http://localhost:9010
S3_REGION=auto
S3_BUCKET=unsaid-private
S3_ACCESS_KEY_ID=unsaid_dev
S3_SECRET_ACCESS_KEY=unsaid_local_dev
S3_FORCE_PATH_STYLE=true
UPLOAD_URL_TTL_SECONDS=300
DOWNLOAD_URL_TTL_SECONDS=300

CORS_ORIGIN=http://localhost:3010

# echo-stub makes no network calls. anthropic answers well but cannot prove what
# code ran, so the ledger records those accesses as unattested. phala runs the
# model in an Intel TDX enclave and publishes a measurement we can write to the
# receipt — the only option here that makes "which code read my memory" a
# question a stranger can answer.
AI_PROVIDER=echo-stub
# ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# A RedPill inference key from cloud.phala.com — not a Phala Cloud (phak_) key,
# which authenticates the CVM product and is rejected here.
# PHALA_API_KEY=
PHALA_MODEL=google/gemma-4-31b-it
PHALA_BASE_URL=https://inference.phala.com/v1
# Reflections per user per rolling week. Echo is the only unbounded cost and
# the only path that sends content to a third party, so this bounds both.
ECHO_WEEKLY_QUOTA=50

SOLANA_NETWORK=devnet
