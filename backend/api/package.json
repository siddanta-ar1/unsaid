{
  "name": "@unsaid/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env src/db/migrate.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "@aws-sdk/client-s3": "^3.905.0",
    "@aws-sdk/s3-request-presigner": "^3.905.0",
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@unsaid/crypto": "workspace:*",
    "@unsaid/types": "workspace:*",
    "drizzle-orm": "^0.44.6",
    "fastify": "^5.6.1",
    "fastify-type-provider-zod": "^6.0.0",
    "jose": "^6.1.0",
    "postgres": "^3.4.7",
    "zod": "^4.1.5",
    "@unsaid/solana": "workspace:*"
  },
  "devDependencies": {
    "@unsaid/config": "workspace:*",
    "drizzle-kit": "^0.31.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
