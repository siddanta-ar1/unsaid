# ─── Secrets ──────────────────────────────────────────────────────────────
# Deny by shape, not by known filename. Anything matching these patterns stays
# out even if someone adds a new one; `.env.example` is the single documented
# exception and must only ever contain local-development placeholders.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.keystore
id_rsa*
id_ed25519*
credentials.json
service-account*.json

# Solana keypairs are PRIVATE KEYS. The program keypair controls the program
# address and can deploy to it; a wallet keypair controls funds. Neither ever
# belongs in git — back them up out of band. A deployment is verifiable from
# the public program address in Anchor.toml and declare_id!().
*keypair*.json
keypairs/

# ─── Build output ─────────────────────────────────────────────────────────
node_modules/
dist/
.next/
.turbo/
coverage/
*.tsbuildinfo
target/
test-ledger/

# Next regenerates this on every dev run and build, writing different import
# paths for each, so tracking it leaves the tree permanently dirty. CI builds
# before it typechecks, so the file exists whenever tsconfig resolves it.
next-env.d.ts

# ─── Local noise ──────────────────────────────────────────────────────────
.DS_Store
*.log

# Vercel CLI link state (project and org ids). Machine-local.
.vercel

# Program deploy keypair — whoever holds this controls upgrades.
target/deploy/*-keypair.json
